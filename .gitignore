# Local runtime state. Never committed: it holds the pilot database, generated
# artifacts and automation evidence.
var/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Environments
.venv/

# Scratch files. A commit-message file is plumbing, never content: including it in
# .gitignore stops `git add -A` from sweeping it into the commit that consumed it.
.commit-msg
.git-commit-msg.tmp

# Probe output dumps (the scripts themselves are retained; their output is scratch)
_probe_results*.json
_greenhouse_form_probe.json

# Local overrides
.env
.env.local

# Node (web app)
node_modules/
.next/
out/
